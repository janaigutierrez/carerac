# Google Calendar API Configuration
# ================================
# Required for calendar availability feature in booking section
#
# To set up:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable "Google Calendar API"
# 4. Create an API key (APIs & Services > Credentials > Create Credentials > API Key)
# 5. Restrict the API key to only Calendar API for security
# 6. Make sure your calendar is set to PUBLIC or use a service account

VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_CALENDAR_ID=your_calendar_id_here

# Calendar ID can be:
# - Your email (if using your primary calendar): example@gmail.com
# - A specific calendar ID from Calendar Settings > Integrate calendar

# EmailJS Configuration
# =====================
# Required for sending booking request emails
#
# To set up:
# 1. Go to https://www.emailjs.com/
# 2. Create an account and add an email service
# 3. Create an email template with these variables:
#    - {{name}}, {{email}}, {{phone}}, {{checkIn}}, {{guests}}, {{message}}
# 4. Get your credentials from the dashboard

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
