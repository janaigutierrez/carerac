# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/carerac?retryWrites=true&w=majority

# Admin panel credentials
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# In .env.local, escape $ as \$ to prevent variable expansion. In Netlify UI, use the raw value.
ADMIN_PASSWORD_HASH=''

# Session secret (32+ random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# EmailJS (client-side — public by design, per EmailJS architecture)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_CONFIRMATION_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudinary (server-side credentials for admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same cloud name exposed for building public URLs on the client
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
